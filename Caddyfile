{
	email pedro@pedrobonini.com
}

pedrobonini.com, www.pedrobonini.com {
	root * /usr/share/caddy
	file_server

	encode gzip zstd

	header {
		# security
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "interest-cohort=()"

		# remove server header
		-Server
	}

	# cache static assets aggressively
	@static path *.css *.js *.woff2 *.svg *.png *.jpg *.webp *.ico
	header @static Cache-Control "public, max-age=31536000, immutable"

	# don't cache HTML so updates show up immediately
	@html path *.html /
	header @html Cache-Control "public, max-age=0, must-revalidate"

	# pretty 404
	handle_errors {
		@404 expression {http.error.status_code} == 404
		rewrite @404 /404.html
		file_server
	}

	# redirect www to apex
	@www host www.pedrobonini.com
	redir @www https://pedrobonini.com{uri} permanent
}
