---
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../lib/config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: string;
  lang: 'en' | 'pt';
  readingTime?: string;
  series?: string;
  part?: number;
  slug: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  lang,
  readingTime,
  series,
  part,
  slug,
} = Astro.props;

const editUrl = `https://github.com/phfbonini/pedrobonini-site/edit/main/src/content/posts/${slug}.md`;
const dateFmt = pubDate.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const seriesHref = series ? (lang === 'pt' ? `/pt/series/${series}` : `/series/${series}`) : null;

const labels = {
  en: {
    backToBlog: '← all posts',
    edit: 'edit on github ↗',
    series: 'part of',
    updated: 'updated',
  },
  pt: {
    backToBlog: '← todos os posts',
    edit: 'editar no github ↗',
    series: 'parte de',
    updated: 'atualizado',
  },
};
const t = labels[lang];
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  type="article"
  pubDate={pubDate}
>
  <a href={lang === 'pt' ? '/pt/blog' : '/blog'} class="back">{t.backToBlog}</a>

  <div class="post-meta">
    <span class="mono">{dateFmt}</span>
    <span class="sep">·</span>
    <span class="mono">{category}</span>
    {readingTime && (
      <>
        <span class="sep">·</span>
        <span class="mono">{readingTime}</span>
      </>
    )}
    <span class="sep">·</span>
    <span class={`lang-pill lang-${lang}`}>{lang}</span>
  </div>

  <h1>{title}</h1>
  <p class="post-description">{description}</p>

  {series && seriesHref && (
    <div class="series-badge">
      {t.series} <a href={seriesHref}>{series}</a>
      {part && <span class="mono"> · #{part}</span>}
    </div>
  )}

  <article class="prose">
    <slot />
  </article>

  <footer class="post-footer">
    {updatedDate && (
      <div class="updated mono">
        {t.updated}: {updatedDate.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US')}
      </div>
    )}
    <a href={editUrl} target="_blank" rel="noopener" class="edit-link">{t.edit}</a>
  </footer>
</BaseLayout>

<style>
  .back {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-tertiary);
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1.5rem;
  }
  .back:hover {
    color: var(--text);
    opacity: 1;
  }

  .post-meta {
    display: flex;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    margin-bottom: 0.75rem;
    align-items: center;
    flex-wrap: wrap;
  }

  .post-meta .sep {
    color: var(--text-tertiary);
  }

  .lang-pill {
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 10px;
  }

  .lang-pill.lang-en {
    background: var(--tag-en-bg);
    color: var(--tag-en-fg);
  }

  .lang-pill.lang-pt {
    background: var(--tag-pt-bg);
    color: var(--tag-pt-fg);
  }

  h1 {
    font-size: 24px;
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .post-description {
    color: var(--text-secondary);
    font-size: 15px;
    margin-bottom: 2rem;
  }

  .series-badge {
    background: var(--bg-secondary);
    border-radius: var(--radius-md);
    padding: 8px 12px;
    font-size: 13px;
    margin-bottom: 2rem;
    color: var(--text-secondary);
  }

  .prose {
    font-size: 15px;
    line-height: 1.75;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 0.5px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
  }

  .edit-link {
    color: var(--text-tertiary);
    text-decoration: none;
  }

  .edit-link:hover {
    color: var(--text);
    opacity: 1;
  }
</style>
