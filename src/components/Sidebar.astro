---
import { NAV, SITE } from '../lib/config';

interface Props {
  lang?: 'en' | 'pt';
  currentPath?: string;
}

const { lang = 'en', currentPath = '' } = Astro.props;
const items = NAV[lang];
const altHref = lang === 'en' ? '/pt' : '/';
const rssHref = lang === 'en' ? '/rss.xml' : '/pt/rss.xml';

const labels = {
  en: { search: 'Search this page…', noResults: 'No results on this page.' },
  pt: { search: 'Buscar nesta página…', noResults: 'Nenhum resultado nesta página.' },
};
const t = labels[lang];
---

<header class="site-header">
  <div class="row primary">
    <nav class="primary-nav">
      {
        items.map((item) => (
          <a
            href={item.href}
            class:list={[{ active: currentPath === item.href }]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="right">
      <div class="social">
        <a href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.78 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.82 1.18 3.07 0 4.41-2.69 5.38-5.25 5.66.41.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.55A11.5 11.5 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" />
          </svg>
        </a>
        <a href={SITE.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.36V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
          </svg>
        </a>
        <a href={`mailto:${SITE.email}`} aria-label="Email">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
          </svg>
        </a>
        <a href={rssHref} aria-label="RSS">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.18 15.64a2.18 2.18 0 1 1 0 4.36 2.18 2.18 0 0 1 0-4.36zM4 4.44A19.56 19.56 0 0 1 19.56 20h-2.83A16.73 16.73 0 0 0 4 7.28V4.44zm0 5.66a13.9 13.9 0 0 1 9.9 9.9h-2.83A11.07 11.07 0 0 0 4 12.93V10.1z" />
          </svg>
        </a>
      </div>

      <div class="divider"></div>

      <a href={altHref} class="lang-toggle" aria-label="Switch language">
        <span class={lang === 'en' ? 'active' : ''}>en</span>
        <span class="sep">/</span>
        <span class={lang === 'pt' ? 'active' : ''}>pt</span>
      </a>

      <button
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Toggle dark mode"
        type="button"
      >
        <svg class="icon-light" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg class="icon-dark" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="row search-row" id="page-search-row" hidden>
    <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7" />
      <path d="m20 20-3.5-3.5" />
    </svg>
    <input
      id="page-search-input"
      type="search"
      placeholder={t.search}
      aria-label={t.search}
      autocomplete="off"
      spellcheck="false"
      data-empty-message={t.noResults}
    />
    <span id="page-search-count" class="search-count mono" aria-live="polite"></span>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 0.5px solid var(--border);
    padding-bottom: 1rem;
    margin-bottom: 2rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .row[hidden] {
    display: none;
  }

  .primary {
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .primary-nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    font-size: 14px;
  }

  .primary-nav a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition);
  }

  .primary-nav a:hover {
    color: var(--text);
    opacity: 1;
  }

  .primary-nav a.active {
    color: var(--text);
    font-weight: 500;
    border-bottom: 0.5px solid var(--text);
    padding-bottom: 2px;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .social {
    display: flex;
    gap: 0.7rem;
    align-items: center;
  }

  .social a {
    color: var(--text-tertiary);
    display: inline-flex;
    transition: color var(--transition);
  }

  .social a:hover {
    color: var(--text);
    opacity: 1;
  }

  .divider {
    width: 1px;
    height: 14px;
    background: var(--border);
  }

  .lang-toggle {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-tertiary);
    text-decoration: none;
    display: flex;
    gap: 3px;
  }

  .lang-toggle .active {
    color: var(--text);
  }

  .lang-toggle .sep {
    color: var(--text-tertiary);
  }

  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-secondary);
    padding: 4px;
    display: flex;
    align-items: center;
    transition: color var(--transition);
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .icon-dark {
    display: none;
  }

  [data-theme='dark'] .icon-light {
    display: none;
  }

  [data-theme='dark'] .icon-dark {
    display: block;
  }

  .search-row {
    margin-top: 0.75rem;
    background: var(--bg-secondary);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-md);
    padding: 6px 10px;
    transition: border-color var(--transition);
  }

  .search-row:focus-within {
    border-color: var(--border-strong);
  }

  .search-icon {
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  #page-search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--text);
    min-width: 0;
  }

  #page-search-input::placeholder {
    color: var(--text-tertiary);
  }

  #page-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  .search-count {
    font-size: 11px;
    color: var(--text-tertiary);
    flex-shrink: 0;
  }

  @media (max-width: 600px) {
    .primary {
      gap: 0.75rem;
    }
    .primary-nav {
      gap: 0.875rem;
      font-size: 13px;
    }
    .right {
      gap: 0.5rem;
    }
  }
</style>

<script is:inline>
  (function () {
    const stored = localStorage.getItem('theme');
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initial = stored || (systemDark ? 'dark' : 'light');
    document.documentElement.setAttribute('data-theme', initial);
  })();
</script>

<script>
  // Theme toggle
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('theme-toggle');
    if (btn) {
      btn.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'dark' ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
      });
    }

    // Page-level search: filter [data-search] elements on the current page
    const items = Array.from(document.querySelectorAll<HTMLElement>('main [data-search]'));
    const row = document.getElementById('page-search-row') as HTMLElement | null;
    const input = document.getElementById('page-search-input') as HTMLInputElement | null;
    const countEl = document.getElementById('page-search-count');
    if (!row || !input || items.length === 0) return;

    row.hidden = false;
    const total = items.length;
    const main = document.querySelector('main');
    const emptyMsg = input.dataset.emptyMessage || 'No results.';

    let emptyNode = main?.querySelector<HTMLElement>('.page-search-empty') ?? null;
    if (!emptyNode && main) {
      emptyNode = document.createElement('p');
      emptyNode.className = 'page-search-empty';
      emptyNode.textContent = emptyMsg;
      emptyNode.style.cssText =
        'color: var(--text-tertiary); font-size: 13px; padding: 1rem 0; display: none;';
      main.appendChild(emptyNode);
    }

    function apply() {
      const q = (input!.value || '').trim().toLowerCase();
      let visible = 0;
      const visibleGroups = new Set<HTMLElement>();

      for (const el of items) {
        const hay = (el.dataset.search || '').toLowerCase();
        const match = !q || hay.includes(q);
        el.style.display = match ? '' : 'none';
        if (match) {
          visible++;
          const grp = el.closest<HTMLElement>('[data-search-group]');
          if (grp) visibleGroups.add(grp);
        }
      }

      document.querySelectorAll<HTMLElement>('[data-search-group]').forEach((g) => {
        g.style.display = visibleGroups.has(g) || !q ? '' : 'none';
      });

      if (countEl) countEl.textContent = q ? `${visible}/${total}` : '';
      if (emptyNode) emptyNode.style.display = q && visible === 0 ? '' : 'none';
    }

    input.addEventListener('input', apply);

    const url = new URL(window.location.href);
    const initialQ = url.searchParams.get('q');
    if (initialQ) {
      input.value = initialQ;
      apply();
    }
  });
</script>
